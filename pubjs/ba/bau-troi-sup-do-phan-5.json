a vào một chiến dịch nổi dậy chống lại lực lượng người ngoài hành tinh đang chiếm đóng.</p>","tmdb":{"type":"tv","id":"34967","season":5,"vote_average":7.1,"vote_count":1312},"modified":"2026-05-18T18:44:35.000Z","cast":["Noah Wyle","Moon Bloodgood","Will Patton","Drew Roy","Connor Jessup","Maxim Knight","Colin Cunningham","Sarah Carter","Mpho Koaho","Doug Jones"],"director":[],"cast_meta":[{"name":"Noah Wyle","name_vi":null,"name_original":"Noah Wyle","tmdb_id":13526,"profile":"https://image.tmdb.org/t/p/w500/nwyLCQepwg8FX7OXJ4AT4ej8c7i.jpg","tmdb_url":"https://www.themoviedb.org/person/13526"},{"name":"Moon Bloodgood","name_vi":null,"name_original":"Moon Bloodgood","tmdb_id":56455,"profile":"https://image.tmdb.org/t/p/w500/9CGOg5nGFlQ3IWwbElMAEJMm9Iq.jpg","tmdb_url":"https://www.themoviedb.org/person/56455"},{"name":"Will Patton","name_vi":null,"name_original":"Will Patton","tmdb_id":883,"profile":"https://image.tmdb.org/t/p/w500/1V4DbU1mfEim4oaA5bvJywDAKwB.jpg","tmdb_url":"https://www.themoviedb.org/person/883"},{"name":"Drew Roy","name_vi":null,"name_original":"Drew Roy","tmdb_id":207997,"profile":"https://image.tmdb.org/t/p/w500/mdi520IbL1qydAXiREeRt4qw8kT.jpg","tmdb_url":"https://www.themoviedb.org/person/207997"},{"name":"Connor Jessup","name_vi":null,"name_original":"Connor Jessup","tmdb_id":529003,"profile":"https://image.tmdb.org/t/p/w500/uVhhVxdK0uUcawfEE3Jp2YYKFRv.jpg","tmdb_url":"https://www.themoviedb.org/person/529003"},{"name":"Maxim Knight","name_vi":null,"name_original":"Maxim Knight","tmdb_id":117659,"profile":"https://image.tmdb.org/t/p/w500/aVY2r3l9amxdSgXfMCBXuY23ZVL.jpg","tmdb_url":"https://www.themoviedb.org/person/117659"},{"name":"Colin Cunningham","name_vi":null,"name_original":"Colin Cunningham","tmdb_id":1218926,"profile":"https://image.tmdb.org/t/p/w500/5ooKQ9tpLZDtDc5dHeREdvAWAOJ.jpg","tmdb_url":"https://www.themoviedb.org/person/1218926"},{"name":"Sarah Carter","name_vi":null,"name_original":"Sarah Carter","tmdb_id":56825,"profile":"h