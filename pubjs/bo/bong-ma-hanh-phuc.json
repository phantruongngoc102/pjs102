%BAc#cite_note-3\">[3]</a></p><p><br>&nbsp;</p>","tmdb":{"type":"tv","id":"321040","season":1,"vote_average":0,"vote_count":0},"modified":"2026-04-30T17:38:52.000Z","cast":[],"director":[],"cast_meta":[],"keywords":[],"tmdb_checked":true,"pubjs_url":"https://cdn.jsdelivr.net/gh/phantruongngoc102/pjs102@main/pubjs/bo/bong-ma-hanh-phuc.json"}