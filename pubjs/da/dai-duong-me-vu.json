ng mù che mắt, vị thần thám Đại Đường dùng trí tuệ phi phàm dò xét từng manh mối nhỏ, dùng năng lực siêu việt để thấu tỏ lòng người.</p><p>&nbsp;</p>","tmdb":{"type":"tv","id":"289209","season":1,"vote_average":9,"vote_count":1},"modified":"2026-05-30T11:46:19.000Z","cast":["Phùng Thiệu Phong","Li Yu","Shao Yun","Shan Jingyao","Sheng Gangshuai"],"director":[],"cast_meta":[{"name":"Phùng Thiệu Phong","name_vi":"Phùng Thiệu Phong","name_original":"William Feng","tmdb_id":936431,"profile":"https://image.tmdb.org/t/p/w500/tSn5BIRw3Xdj3XYKIycjyNTgl49.jpg","tmdb_url":"https://www.themoviedb.org/person/936431"},{"name":"Li Yu","name_vi":null,"name_original":"Li Yu","tmdb_id":2020920,"profile":"https://image.tmdb.org/t/p/w500/nflAMKyKZQbpDlfBe9nsuboGWFV.jpg","tmdb_url":"https://www.themoviedb.org/person/2020920"},{"name":"Shao Yun","name_vi":null,"name_original":"Shao Yun","tmdb_id":2231099,"profile":"https://image.tmdb.org/t/p/w500/fujBBNxVxG7OnCiUflh5MWvKWyp.jpg","tmdb_url":"https://www.themoviedb.org/person/2231099"},{"name":"Shan Jingyao","name_vi":null,"name_original":"Shan Jingyao","tmdb_id":4814560,"profile":"https://image.tmdb.org/t/p/w500/26S6eJIhSiCKumq9ZXsbEwBxqrO.jpg","tmdb_url":"https://www.themoviedb.org/person/4814560"},{"name":"Sheng Gangshuai","name_vi":null,"name_original":"Sheng Gangshuai","tmdb_id":3287641,"profile":"https://image.tmdb.org/t/p/w500/4RZ5zmCO4zHCR3rInI1XUqg6pzQ.jpg","tmdb_url":"https://www.themoviedb.org/person/3287641"}],"keywords":[],"tmdb_checked":true,"pubjs_url":"https://cdn.jsdelivr.net/gh/phantruongngoc102/pjs102@main/pubjs/da/dai-duong-me-vu.json"}