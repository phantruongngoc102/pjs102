dd26d894b2","link_m3u8":"https://vip.opstream10.com/20260718/34301_fb329817/index.m3u8"},{"name":"14","slug":"14","filename":"The Drops of God_S01E14_The Missing Goddesses","link_embed":"https://vip.opstream10.com/share/d40d53087c6f81c1ac6bd10a87d6b1f1","link_m3u8":"https://vip.opstream10.com/20260718/34302_d40d5308/index.m3u8"},{"name":"15","slug":"15","filename":"The Drops of God_S01E15_Wine, Served With Mystery","link_embed":"https://vip.opstream10.com/share/1bc949fb8a71e4cfab76cdd57cf1dccc","link_m3u8":"https://vip.opstream10.com/20260718/34303_1bc949fb/index.m3u8"}]}],"time":"24 phút/tập","description":"<p>Khi nhà phê bình rượu vang nổi tiếng thế giới Toyotaka Kanzaki qua đời, &nbsp;ông để lại một bộ sưu tập đáng ghen tị. Di chúc hứa sẽ trao toàn bộ gia sản cho bất cứ ai đoán đúng nhãn hiệu và năm sản xuất của 12 loại rượu vang hảo hạng nhất mà ông đã chọn, &nbsp;và loại rượu vang huyền thoại đứng đầu trong số đó, \"Drops of God\" (Giọt Thần). Những người thách đấu là con trai của Toyotaka, &nbsp;Shizuku Kanzaki, và một nhà phê bình trẻ tuổi, Issei Tomine, người được Toyotaka nhận làm con nuôi.</p>","tmdb":{"type":"tv","id":"306121","season":1,"vote_average":9,"vote_count":1},"modified":"2026-07-18T22:16:40.000Z","cast":["Takuya Sato","Kazuya Kamenashi","Maaya Uchida","Banjo Ginga","Yuhko Kaida","Shinshu Fuji","Misa Watanabe","Yuuya Uchida","Jin Urayama","Lynn","Akihiko Ishizumi","Soshiro Hori","Konomi Kohara"],"director":[],"cast_meta":[{"name":"Takuya Sato","name_vi":null,"name_original":"Takuya Sato","tmdb_id":1253431,"profile":"https://image.tmdb.org/t/p/w500/xZgoTs6DOSneHkoOWL751pQzLru.jpg","tmdb_url":"https://www.themoviedb.org/person/1253431"},{"name":"Kazuya Kamenashi","name_vi":null,"name_original":"Kazuya Kamenashi","tmdb_id":1186429,"profile":"https://image.tmdb.org/t/p/w500/qCScLh3AOnHjQKT9C9G4alg8k8c.jpg","tmdb_url":"https://www.themoviedb.org/person/1186429"},{"name":"Maaya Uchida","name_vi":null,"name_original":"Maaya Uchida","tmdb_id":1296667,"p