 thử thách nơi công sở, và trong quá trình đồng cam cộng khổ ấy, tình yêu giữa họ đã đầm chồi. Cuối cùng, họ không chỉ có được tình yêu viên mãn mà còn đưa khách sạn Phổ Vinh trở thành một biểu tượng mới của thành phố...</p>","tmdb":{"type":"tv","id":"281231","season":1,"vote_average":9,"vote_count":1},"modified":"2026-05-03T22:49:24.000Z","cast":["Chung Hán Lương","Chu Châu","Lý Mộng","Kinh Siêu","Ren Bin","Quách Hiểu Đình","Kornchid Boonsathitpakdee","Từ Hải Kiều","Hải Lục"],"director":["王迎"],"cast_meta":[{"name":"Chung Hán Lương","name_vi":"Chung Hán Lương","name_original":"Wallace Chung","tmdb_id":1183233,"profile":"https://image.tmdb.org/t/p/w500/mDJQSyCQdPW2lJDbY46udu0161n.jpg","tmdb_url":"https://www.themoviedb.org/person/1183233"},{"name":"Chu Châu","name_vi":"Chu Châu","name_original":"Zhu Zhu","tmdb_id":1077356,"profile":"https://image.tmdb.org/t/p/w500/rg8OPxvu2xc1Y6YA0paaOBrCX2z.jpg","tmdb_url":"https://www.themoviedb.org/person/1077356"},{"name":"Lý Mộng","name_vi":"Lý Mộng","name_original":"Li Meng","tmdb_id":1174686,"profile":"https://image.tmdb.org/t/p/w500/uMOoic1tyHlzFFG4NdCsiDXZKE1.jpg","tmdb_url":"https://www.themoviedb.org/person/1174686"},{"name":"Kinh Siêu","name_vi":"Kinh Siêu","name_original":"Jing Chao","tmdb_id":1528926,"profile":"https://image.tmdb.org/t/p/w500/6dsz8k3gcXPWRYBpszQyldmT8b.jpg","tmdb_url":"https://www.themoviedb.org/person/1528926"},{"name":"Ren Bin","name_vi":null,"name_original":"Ren Bin","tmdb_id":2349404,"profile":"https://image.tmdb.org/t/p/w500/1Xf1fCJmkd9leRlc7DCkyV7rjbI.jpg","tmdb_url":"https://www.themoviedb.org/person/2349404"},{"name":"Quách Hiểu Đình","name_vi":"Quách Hiểu Đình","name_original":"Guo Xiaoting","tmdb_id":1513376,"profile":"https://image.tmdb.org/t/p/w500/3u7cgGNe0s35FhjuOnNfytiJ0Z8.jpg","tmdb_url":"https://www.themoviedb.org/person/1513376"},{"name":"Kornchid Boonsathitpakdee","name_vi":null,"name_original":"Kornchid Boonsathitpakdee","tmdb_id":2509434,"profile":"https://image.tmdb.org/t/p/w500/mY