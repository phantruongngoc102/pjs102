 chính mình.</p>","tmdb":{"type":"tv","id":"325368","season":1,"vote_average":0,"vote_count":0},"modified":"2026-06-20T13:27:29.000Z","cast":["Yang Chuanbei","Yan Jiaying","Liu Jiameng","Liu Jiaxi","Kan Ziyi","Zhou Rui"],"director":[],"cast_meta":[{"name":"Yang Chuanbei","name_vi":null,"name_original":"Yang Chuanbei","tmdb_id":2745514,"profile":"https://image.tmdb.org/t/p/w500/nBMrvszNQANEyb0IfZjF5ynYQ5c.jpg","tmdb_url":"https://www.themoviedb.org/person/2745514"},{"name":"Yan Jiaying","name_vi":null,"name_original":"Yan Jiaying","tmdb_id":1793618,"profile":"https://image.tmdb.org/t/p/w500/v3AxHTQKzraBvQS5CNb33h7z5ZD.jpg","tmdb_url":"https://www.themoviedb.org/person/1793618"},{"name":"Liu Jiameng","name_vi":null,"name_original":"Liu Jiameng","tmdb_id":5900755,"profile":null,"tmdb_url":"https://www.themoviedb.org/person/5900755"},{"name":"Liu Jiaxi","name_vi":null,"name_original":"Liu Jiaxi","tmdb_id":2250279,"profile":"https://image.tmdb.org/t/p/w500/fTxtVoGr8vJyMCMCqbaFYLLwCN5.jpg","tmdb_url":"https://www.themoviedb.org/person/2250279"},{"name":"Kan Ziyi","name_vi":null,"name_original":"Kan Ziyi","tmdb_id":6282147,"profile":null,"tmdb_url":"https://www.themoviedb.org/person/6282147"},{"name":"Zhou Rui","name_vi":null,"name_original":"Zhou Rui","tmdb_id":6282160,"profile":null,"tmdb_url":"https://www.themoviedb.org/person/6282160"}],"keywords":[],"tmdb_checked":true,"pubjs_url":"https://cdn.jsdelivr.net/gh/phantruongngoc102/pjs102@main/pubjs/na/nam-thang-ruc-lua.json"}