iện đại của mình để giúp Tuân Trường Hạo tìm ra sự thật về nguyên nhân cái chết của anh cả mình.</p>","tmdb":{"type":"tv","id":"250908","season":1,"vote_average":0,"vote_count":0},"modified":"2026-05-31T12:03:35.000Z","cast":["Zhang Zining","Lý Cửu Lâm","Ma Dongchen","Zhu Moyan","Liu Muzi","Han Qing","Pan Yuanjia"],"director":[],"cast_meta":[{"name":"Zhang Zining","name_vi":null,"name_original":"Zhang Zining","tmdb_id":3943195,"profile":"https://image.tmdb.org/t/p/w500/glCOV4UXKaoQi4azSXNQEw8GQ4B.jpg","tmdb_url":"https://www.themoviedb.org/person/3943195"},{"name":"Lý Cửu Lâm","name_vi":"Lý Cửu Lâm","name_original":"Li Jiulin","tmdb_id":2752786,"profile":"https://image.tmdb.org/t/p/w500/29NG6ZFlXsvfvsF7eIOW6OTKRou.jpg","tmdb_url":"https://www.themoviedb.org/person/2752786"},{"name":"Ma Dongchen","name_vi":null,"name_original":"Ma Dongchen","tmdb_id":3383239,"profile":"https://image.tmdb.org/t/p/w500/45D1M1GgwAS57EkDnlPjK2PJqoe.jpg","tmdb_url":"https://www.themoviedb.org/person/3383239"},{"name":"Zhu Moyan","name_vi":null,"name_original":"Zhu Moyan","tmdb_id":3775075,"profile":"https://image.tmdb.org/t/p/w500/l93NJrDL2ZXDPFrAZB3w4RA8P8.jpg","tmdb_url":"https://www.themoviedb.org/person/3775075"},{"name":"Liu Muzi","name_vi":null,"name_original":"Liu Muzi","tmdb_id":4578286,"profile":"https://image.tmdb.org/t/p/w500/xjUcYNhxxfi0ANKT9xAMPflZhYK.jpg","tmdb_url":"https://www.themoviedb.org/person/4578286"},{"name":"Han Qing","name_vi":null,"name_original":"Han Qing","tmdb_id":3093440,"profile":"https://image.tmdb.org/t/p/w500/jU4Ta4QvUOo66txytTj6N2kKEUs.jpg","tmdb_url":"https://www.themoviedb.org/person/3093440"},{"name":"Pan Yuanjia","name_vi":null,"name_original":"Pan Yuanjia","tmdb_id":2667167,"profile":"https://image.tmdb.org/t/p/w500/7yQKtEl35bWXjEk2jQAurN5lYCV.jpg","tmdb_url":"https://www.themoviedb.org/person/2667167"}],"keywords":[],"tmdb_checked":true,"pubjs_url":"https://cdn.jsdelivr.net/gh/phantruongngoc102/pjs102@main/pubjs/ph/phu-quan-dai-nhan-dung-so-thiep.