/3d2515739e79e2d0700e7b6b75f6b2a1","link_m3u8":"https://vip.opstream90.com/20260505/30981_3d251573/index.m3u8"}]}],"time":"15 phút/tập","description":"<p>Một tai nạn bất ngờ đưa Tiêu Ninh xuyên không đến triều Đại Cảnh, trở thành con rể ở rể nhà họ Tô. Chàng dùng cổ pháp biến hóa cho trà và rượu thêm phần thơm ngon, khiến mọi người đua nhau giành giật. Chàng còn sáng tạo báo giấy, chiêu mộ anh tài, giúp công chúa tung hoành triều đường. Đối mặt với sự gây khó dễ của con gái thương nhân, sự khinh thường của vợ cũ, chàng vẫn điềm nhiên bày binh bố trận, dùng việc kinh doanh làm vũ khí lật đổ thành kiến thế tục. Giữa những lời lẽ khinh bỉ, chàng viết nên truyền kỳ vượt qua nghịch cảnh.</p>","tmdb":{"type":"tv","id":"294462","season":2,"vote_average":6,"vote_count":1},"modified":"2026-05-05T11:43:49.000Z","cast":["Pan Yihong","Zhu Rongjun","Fan Meng","Roada Xu"],"director":[],"cast_meta":[{"name":"Pan Yihong","name_vi":null,"name_original":"Pan Yihong","tmdb_id":4510273,"profile":"https://image.tmdb.org/t/p/w500/5lKTCBZkEMSOTenV1N0aoNTVegZ.jpg","tmdb_url":"https://www.themoviedb.org/person/4510273"},{"name":"Zhu Rongjun","name_vi":null,"name_original":"Zhu Rongjun","tmdb_id":3734499,"profile":"https://image.tmdb.org/t/p/w500/pYTPElWgI2b1Wx8n23gpIs7PwmT.jpg","tmdb_url":"https://www.themoviedb.org/person/3734499"},{"name":"Fan Meng","name_vi":null,"name_original":"Fan Meng","tmdb_id":1940733,"profile":"https://image.tmdb.org/t/p/w500/otKOPSVzHsVerDlPd2A76GpnGNA.jpg","tmdb_url":"https://www.themoviedb.org/person/1940733"},{"name":"Roada Xu","name_vi":null,"name_original":"Roada Xu","tmdb_id":3177605,"profile":"https://image.tmdb.org/t/p/w500/gQF76AVcCboA00RawAopbcZsHiv.jpg","tmdb_url":"https://www.themoviedb.org/person/3177605"}],"keywords":[],"tmdb_checked":true,"pubjs_url":"https://cdn.jsdelivr.net/gh/phantruongngoc102/pjs102@main/pubjs/re/re-hien-phan-2.json"}