b6aaf75ec07637d","link_m3u8":"https://vip.opstream13.com/20260605/23284_b7c2ef08/index.m3u8"},{"name":"19","slug":"19","filename":"Phim TVB lồng tiếng Thiên Sư Kỳ Môn 4K 19#20 # Miêu Kiều Vỹ, Ông Mỹ Linh, Lưu Đan # USLT # 1984","link_embed":"https://vip.opstream13.com/share/ca72268b3fe6f53e6871f210e3480046","link_m3u8":"https://vip.opstream13.com/20260605/23285_ca72268b/index.m3u8"},{"name":"20","slug":"20","filename":"Phim TVB lồng tiếng Thiên Sư Kỳ Môn 4K 20#20 # Miêu Kiều Vỹ, Ông Mỹ Linh, Lưu Đan # USLT # 1984","link_embed":"https://vip.opstream13.com/share/c8377ad2a50fb65de28b11cfc628d75c","link_m3u8":"https://vip.opstream13.com/20260605/23286_c8377ad2/index.m3u8"}]}],"time":"45 phút/tập","description":"<p>Sư phụ Cheung bị thương sau cuộc giao tranh với thủ lĩnh giáo phái Suen Ci. Ông bỏ trốn và gặp người học trò tương lai của mình là Szeto Man Mo, cũng như con gái của một quan chức chính phủ, Lam Chor Yin. Mo đã đính hôn với Yin nhưng anh ta không hề chung thủy với cô. Mặc dù Yin yêu anh ta hết lòng, Mo vẫn bỏ rơi cô vào ngày cưới. Không lâu sau, Mo phải lòng nữ diễn viên Fa Ying Fung, mà không hề biết đến bộ mặt giả dối của cô ta. Sau khi bị Fung làm tổn thương nghiêm trọng, Mo nhận ra rằng Yin mới là tình yêu đích thực của mình và cuối cùng anh ta quay trở lại với cô. Thật không may, linh hồn của Yin bị Ci bắt giữ vào đêm tân hôn. Để cứu vợ, Mo bắt đầu luyện tập ma thuật đen nhưng điều này dẫn đến những hậu quả thảm khốc.</p>","tmdb":{"type":"tv","id":"110080","season":1,"vote_average":8,"vote_count":3},"modified":"2026-06-05T23:25:45.000Z","cast":["Miêu Kiều Vỹ","Barbara Yung","Lưu Đan","Sek Kin","Quách Phong","Marylinn Wong Cho-Shut","Liu Chun-Hung","Pak Man-Biu","Sam Kam","Ho Bik-Kin","Lạc Ứng Quân","Mạch Tử Vân","Ngô Quân Như","Ngô Trấn Vũ","Lưu Thanh Vân"],"director":[],"cast_meta":[{"name":"Miêu Kiều Vỹ","name_vi":"Miêu Kiều Vỹ","name_original":"Michael Miu Kiu-Wai","tmdb_id":236075,"profile":"https://image.tmdb.org/t/p/w500/gJt4HBE493fHSBjHezSuA75VQ4A.