d9e6147085bca7324be293","link_m3u8":"https://vip.opstream90.com/20260627/35678_05697152/index.m3u8"}]}],"time":"45 phút/tập","description":"<p>Tiền Phi, một nhân viên ngân hàng, đang lên kế hoạch cho một cuộc sống viên mãn. Nhưng sau khi bị hôn phu bỏ rơi, cô phải định nghĩa lại cuộc đời mình. Lý Diệc Phi, xuất thân từ một gia đình giàu có, luôn đặt sự nghiệp lên hàng đầu. Bạn gái anh không chịu nổi cảnh nghèo khó nên đã bỏ đi. Để trả tiền vay thế chấp, Tiền Phi cho Diệc Phi thuê một căn phòng, và họ trở thành cộng sự. Tiền Phi đã dũng cảm đối mặt với thử thách và trưởng thành qua quá trình này. Hành trình của họ được đánh dấu bằng những va chạm, nhưng họ đã yêu nhau và quyết định cùng nhau hướng tới tương lai.</p>","tmdb":{"type":"tv","id":"230311","season":1,"vote_average":0,"vote_count":0},"modified":"2026-06-26T23:24:52.000Z","cast":["Đàn Kiện Thứ","Vương Sở Nhiên","Trương Hạo Duy","Khương Bội Dao","Christine Zheng","Elisa Ye","Shao Weitong","Lưu Nhuế Lân","Lý Nãi Văn","Yang Tongshu"],"director":["Cui Liang"],"cast_meta":[{"name":"Đàn Kiện Thứ","name_vi":"Đàn Kiện Thứ","name_original":"Tan Jianci","tmdb_id":2122379,"profile":"https://image.tmdb.org/t/p/w500/3TxJqYIDQM3BOicpjAjSMr88bja.jpg","tmdb_url":"https://www.themoviedb.org/person/2122379"},{"name":"Vương Sở Nhiên","name_vi":"Vương Sở Nhiên","name_original":"Wang Churan","tmdb_id":2271369,"profile":"https://image.tmdb.org/t/p/w500/jHSQ3ZOfFhszPuz1kG0zkpHwe8N.jpg","tmdb_url":"https://www.themoviedb.org/person/2271369"},{"name":"Trương Hạo Duy","name_vi":"Trương Hạo Duy","name_original":"Zhang Haowei","tmdb_id":2619965,"profile":"https://image.tmdb.org/t/p/w500/bDjAlf80pDTK10ru3jkMV4R2W9b.jpg","tmdb_url":"https://www.themoviedb.org/person/2619965"},{"name":"Khương Bội Dao","name_vi":"Khương Bội Dao","name_original":"Jiang Peiyao","tmdb_id":1897341,"profile":"https://image.tmdb.org/t/p/w500/dPXXxRNpU8r1V0vpFpEmdIspkPU.jpg","tmdb_url":"https://www.themoviedb.org/person/1897341"},{"name":"Christine Zheng","name_v