ttps://vip.opstream90.com/share/63c6182693644ee5d5724dc5103748cb","link_m3u8":"https://vip.opstream90.com/20260627/35725_63c61826/index.m3u8"}]}],"time":"45 phút/tập","description":"<p>\"Vân Tú Hành\" là một bộ phim cổ trang do Chu Thiếu Kiệt (Chúc Khanh Hảo) đạo diễn, Lý Nhất Đồng (Cuồng Tiêu), Tăng Thuấn Hy (Liên Hoa Lâu), Đặng Vi (Tiêu Sái Giai Nhân Đạm Đạm Trang\") đóng vai chính. Bộ phim được chuyển thể từ tác phẩm Saiunkoku Monogatari của Sai Yukino. Cửu Thành trong truyền thuyết có một vị tiểu thư nghèo xuất thân danh môn Phạm Vân (Lý Nhất Đồng thủ vai) và một vị thành chủ Tề Tranh (Tăng Thuấn Hy thủ vai). Họ từ việc thử thách đối phương cho đến sự tin tưởng lẫn nhau, hai người cùng nhau vượt qua khó khăn để phục vụ nhân dân, cuối cùng họ có được cả tình bằng hữu và tình yêu; Phạm Vân cũng giúp Tề Tranh bình thiên hạ, phá bỏ lễ giáo cũ và giải quyết khủng hoảng ở Cửu Thành, cùng nhau xây dựng một Cửu Thành phồn thịnh.</p>","tmdb":{"type":"tv","id":"239901","season":1,"vote_average":0,"vote_count":0},"modified":"2026-07-01T17:46:07.000Z","cast":["Lý Nhất Đồng","Tăng Thuấn Hy","Đặng Vi","Đại Lộ Oa","Vương Dĩ Luân","Trình Hoằng Hâm","Điền Gia Thụy","Jian Yuxi","Fan Jingwen"],"director":["朱少杰"],"cast_meta":[{"name":"Lý Nhất Đồng","name_vi":"Lý Nhất Đồng","name_original":"Li Yitong","tmdb_id":1736257,"profile":"https://image.tmdb.org/t/p/w500/jfostFmHde0D1Wj9F57GWHEVzmO.jpg","tmdb_url":"https://www.themoviedb.org/person/1736257"},{"name":"Tăng Thuấn Hy","name_vi":"Tăng Thuấn Hy","name_original":"Joseph Zeng","tmdb_id":1803092,"profile":"https://image.tmdb.org/t/p/w500/hfMNwzZv7SxJ6d8gk8rhPZdg4C8.jpg","tmdb_url":"https://www.themoviedb.org/person/1803092"},{"name":"Đặng Vi","name_vi":"Đặng Vi","name_original":"Deng Wei","tmdb_id":3082099,"profile":"https://image.tmdb.org/t/p/w500/AtcwQb1B20rvGCw3JRCbOQyVpcN.jpg","tmdb_url":"https://www.themoviedb.org/person/3082099"},{"name":"Đại Lộ Oa","name_vi":"Đại Lộ Oa","name_original":"Dai Luwa","tmdb_id":2190499,"profile":"h