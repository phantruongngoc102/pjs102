":"https://vip.opstream90.com/20260529/33299_1036079c/index.m3u8"},{"name":"13","slug":"13","filename":"Xuân Đằng Đẵng Sắp Tàn Xuân Đằng Đẵng Sắp Tàn Ep13-YOUKU-Drama, Film, Show, Anime","link_embed":"https://vip.opstream90.com/share/b3d535661b8f07d8a9fc36fa6c7b05c8","link_m3u8":"https://vip.opstream90.com/20260605/33863_b3d53566/index.m3u8"},{"name":"14","slug":"14","filename":"Xuân Đằng Đẵng Sắp Tàn Xuân Đằng Đẵng Sắp Tàn Ep14-YOUKU-Drama, Film, Show, Anime","link_embed":"https://vip.opstream90.com/share/a890e973e0be40ad566636b229ded3c8","link_m3u8":"https://vip.opstream90.com/20260605/33864_a890e973/index.m3u8"},{"name":"15","slug":"15","filename":"Xuân Đằng Đẵng Sắp Tàn Xuân Đằng Đẵng Sắp Tàn Ep15-YOUKU-Drama, Film, Show, Anime","link_embed":"https://vip.opstream90.com/share/a4a87e583804c00a14032b615ae88f53","link_m3u8":"https://vip.opstream90.com/20260605/33865_a4a87e58/index.m3u8"},{"name":"16","slug":"16","filename":"Xuân Đằng Đẵng Sắp Tàn Xuân Đằng Đẵng Sắp Tàn Ep16-YOUKU-Drama, Film, Show, Anime","link_embed":"https://vip.opstream90.com/share/0602cae8eddc659a9064d8c7fb2bfaed","link_m3u8":"https://vip.opstream90.com/20260605/33866_0602cae8/index.m3u8"}]}],"time":"14 phút/tập","description":"<p>Nơi cung cấm sâu thẳm, nàng là nhị công chúa sắc sảo ẩn mình, chuyên tâm bào chế độc dược. Phía ngoài cung cấm, y là sát thủ mang mối thù diệt môn, mai danh ẩn tính, chỉ để tìm muội muội và báo thù. Trong một yến tiệc cung đình, người xưa đeo mặt nạ trở về, nhưng hình xăm sau lưng sớm đã bị xóa sạch. Y là cậu thiếu niên trong rừng sáu năm trước của nàng chăng? Nàng là người muội muội ruột thịt đã thất lạc nhiều năm của y chăng? Ngọc bội làm tín vật, hình xăm làm bằng chứng, thì ra hết thảy đều hướng về một âm mưu động trời. Tranh giành quyền lực, thân thế hoán đổi, những ân oán đẫm máu của hai thế hệ, cuối cùng hóa thành một cuộc hợp tác gài bẫy để phản công trong tuyệt cảnh. Công chúa và thiếu niên, từ bỏ lỡ lúc nhận nhau đến khi thấu hiểu, bên nhau, mở ra một lối thoát từ trong kẽ hở giữa quyền mưu và chân tình.<br>&nbsp;</p>","tmdb":{"id":"323067","type":"tv","season":1,"vote_average":0,"vote_count":0},"modified":"2026-06-05T22:23:07.000Z","cast":["Hoàng Xuân","Deng Jiawei","Fang Hanbing","Chen Zhihui","Zhang Ruien"],"director":[],"cast_meta":[{"name":"Hoàng Xuân","name_vi":"Hoàng Xuân","name_original":"Wang Xuan","tmdb_id":4061802,"profile":"https://image.tmdb.org/t/p/w500/uoeMh3CtTmu2qx73SnxvLTE400z.jpg","tmdb_url":"https://www.themoviedb.org/person/4061802"},{"name":"Deng Jiawei","name_vi":null,"name_original":"Deng Jiawei","tmdb_id":6240735,"profile":null,"tmdb_url":"https://www.themoviedb.org/person/6240735"},{"name":"Fang Hanbing","name_vi":null,"name_original":"Fang Hanbing","tmdb_id":6240737,"profile":null,"tmdb_url":"https://www.themoviedb.org/person/6240737"},{"name":"Chen Zhihui","name_vi":null,"name_original":"Chen Zhihui","tmdb_id":5020557,"profile":"https://image.tmdb.org/t/p/w500/t9ysiyUyedmW3uHLy0lwFF8RnBS.jpg","tmdb_url":"https://www.themoviedb.org/person/5020557"},{"name":"Zhang Ruien","name_vi":null,"name_original":"Zhang Ruien","tmdb_id":4928100,"profile":"https://image.tmdb.org/t/p/w500/siQJLZYZFjsRiX1IwOSJ5JEEebS.jpg","tmdb_url":"https://www.themoviedb.org/person/4928100"}],"keywords":[],"tmdb_checked":true,"pubjs_url":"https://cdn.jsdelivr.net/gh/phantruongngoc102/pjs102@main/pubjs/xu/xuan-dang-dang-sap-tan.json"}